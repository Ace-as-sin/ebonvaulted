# Waitlist form POST endpoint (required for real submissions)
# Example (home server via tunnel): https://waitlist.example.com/waitlist
VITE_WAITLIST_ENDPOINT=

# Token-gated detailed health check used by /server-status (optional unlock)
# Example: https://waitlist.example.com/health
VITE_WAITLIST_HEALTH_ENDPOINT=

# Public liveness URL for on-load uptime checks on /server-status
# Optional if HEALTH ends with /health (derived as …/live). Example:
# https://waitlist.example.com/live
VITE_WAITLIST_LIVE_ENDPOINT=

# Optional privacy-respecting analytics
VITE_ANALYTICS_ENABLED=false
VITE_ANALYTICS_ENDPOINT=
