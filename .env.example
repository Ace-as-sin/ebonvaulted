# Waitlist form POST endpoint (required for real submissions)
# Production (Netlify): https://ebonvaults.com/waitlist
# Local home server: http://127.0.0.1:8787/waitlist
VITE_WAITLIST_ENDPOINT=

# Optional privacy-respecting analytics
VITE_ANALYTICS_ENABLED=false
VITE_ANALYTICS_ENDPOINT=

# Meta Pixel / Conversions API (marketing). Pixel is client-side; CAPI tokens are server-only on Netlify.
# Create the dataset in Meta Events Manager, then paste the Pixel ID here and in Netlify env.
VITE_META_PIXEL_ID=
# Netlify only (never VITE_*):
# META_PIXEL_ID=
# META_CAPI_ACCESS_TOKEN=
# META_CAPI_TEST_EVENT_CODE=
