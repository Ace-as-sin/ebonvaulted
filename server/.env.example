# Bind address — keep localhost unless you know you need otherwise
HOST=127.0.0.1
PORT=8787

# Comma-separated allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://ebonvaults.com,https://www.ebonvaults.com

# Absolute path recommended for production (outside web roots)
# Example Windows: C:\ebonvaults-data\waitlist.db
DATABASE_PATH=./data/waitlist.db

# 32-byte keys as 64-character hex strings (run: npm run gen-keys)
EMAIL_ENCRYPTION_KEY=
EMAIL_HMAC_KEY=

# Bumped when consent copy / policy changes
CONSENT_POLICY_VERSION=waitlist-v1

# Rate limit: max requests per IP per window
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=60000

# Body size cap (bytes)
BODY_LIMIT_BYTES=8192

# Encrypted DB backups directory (keep separate from keys)
BACKUP_DIR=./backups
