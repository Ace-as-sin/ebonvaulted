# Required: long random secret for detailed /server-status checks (Bearer token).
# Public /live uptime checks do not use this. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WAITLIST_STATUS_TOKEN=

# Directory where signup JSONL files are stored (created if missing).
# Keep this on a disk you control. Relative paths are resolved from server/.
WAITLIST_DATA_DIR=./data

# Comma-separated browser origins allowed to call this server (CORS).
# Include your production site and local Vite origin while developing.
CORS_ORIGIN=https://ebonvaults.com,http://localhost:5173

# Listen port (Cloudflare Tunnel or similar should forward to this).
PORT=8787

# Optional bind host (default 127.0.0.1 — only local machine / tunnel).
HOST=127.0.0.1
